APP_NAME=KaamConnect
APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_generate_with_python_secrets

# MySQL 8+ connection string. Create this database user yourself.
DATABASE_URL=mysql+pymysql://kaamconnect_user:YOUR_MYSQL_PASSWORD@localhost:3306/kaamconnect_db?charset=utf8mb4

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
FRONTEND_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
UPLOAD_DIRECTORY=uploads
MAX_UPLOAD_MB=2
COOKIE_SECURE=false
REVIEWS_REQUIRE_APPROVAL=false
REVIEWS_REQUIRE_VERIFIED_PROVIDER=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

# Password reset links are emailed when SMTP is configured. In development
# without SMTP, the link is returned in the API response and written to the log.
PASSWORD_RESET_EXPIRE_MINUTES=30
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_WINDOW_SECONDS=900
# Optional absolute base URL used in reset emails (defaults to the first FRONTEND_ORIGINS entry).
# PASSWORD_RESET_BASE_URL=https://kaamconnect.example.com

# SMTP delivery (leave SMTP_HOST empty to disable email delivery).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@kaamconnect.local
SMTP_USE_TLS=true
SMTP_USE_SSL=false
